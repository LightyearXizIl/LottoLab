{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LottoLab",
  "version": "0.0.1",
  "identifier": "cn.lightyearxizil.lottolab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LottoLab · 历史号码研究",
        "width": 1440,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
    "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://www.cwl.gov.cn https://webapi.sporttery.cn https://github.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese"]
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "UNCONFIGURED_REPLACE_BEFORE_FIRST_RELEASE",
      "endpoints": [
        "https://github.com/LightyearXizIl/LottoLab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
