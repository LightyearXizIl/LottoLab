{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop permissions for the main window",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "os:allow-platform"
  ]
}
